# ==============================================================================
# Autonomous AI Agent Platform - Environment Configuration
# Copy this file to .env and fill in your real values. Never commit .env to git.
# ==============================================================================

# Backend Server Config
PORT=8000
HOST=0.0.0.0
ENV=development
SECRET_KEY=your-secret-key-here

# Supabase Vector Store & Relational Database
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# AI & LLM Providers
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Speech & Voice Output (Edge-TTS default voice)
DEFAULT_TTS_VOICE=en-US-AriaNeural

# Tool Integrations - Email (Gmail)
# See README for how to obtain a Gmail refresh token via Google OAuth Playground
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER_EMAIL=

# Tool Integrations - WhatsApp / Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Frontend Next.js Public Vars
NEXT_PUBLIC_AGENT_API_URL=http://localhost:8000
NEXT_PUBLIC_AGENT_WS_URL=ws://localhost:8000/ws/agent

# Persistent state defaults to apps/agent/data/agent.sqlite3 for native runs.
# Docker overrides this path to /app/data/agent.sqlite3 on a shared named volume.
# STATE_DB_PATH=/absolute/local/path/agent.sqlite3
API_KEY_REQUIRED=false
AGENT_API_KEY=
WEBHOOK_SECRET=
# Native runs: enable here only if not running a separate worker.
ENABLE_SCHEDULER=false
