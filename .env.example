# ==============================================================================
# Autonomous AI Agent Platform - Environment Configuration
# ==============================================================================

# Backend Server Config
PORT=8000
HOST=0.0.0.0
ENV=development
SECRET_KEY=super-secret-agent-key-change-in-production

# Supabase Vector Store & Relational Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@localhost:5432/postgres

# AI & LLM Providers
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3

GEMINI_API_KEY=your_google_ai_studio_api_key_here
GEMINI_MODEL=gemini-1.5-pro

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Speech & Voice Output (Edge-TTS default voice)
DEFAULT_TTS_VOICE=en-US-AriaNeural

# Tool Integrations - Email (Gmail)
GMAIL_CLIENT_ID=your-gmail-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token
GMAIL_USER_EMAIL=agent@yourdomain.com

# Tool Integrations - WhatsApp / Twilio
TWILIO_ACCOUNT_SID=ACyour_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Frontend Next.js Public Vars
NEXT_PUBLIC_AGENT_API_URL=http://localhost:8000
NEXT_PUBLIC_AGENT_WS_URL=ws://localhost:8000/ws/agent
