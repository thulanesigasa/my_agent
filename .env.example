# ==============================================================================
# Autonomous AI Agent Platform - Environment Configuration
# Copy this file to .env and fill in your real values. Never commit .env to git.
# ==============================================================================

# Backend Server Config
PORT=8000
HOST=0.0.0.0
ENV=development
SECRET_KEY=your-secret-key-here

# Supabase Vector Store & Relational Database
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# AI & LLM Providers
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Speech & Voice Output (Edge-TTS default voice)
DEFAULT_TTS_VOICE=en-US-AriaNeural

# Tool Integrations - Email (Gmail)
# Use connect_gmail.py with your local JSON; see GMAIL_SETUP.md.
# Legacy environment credentials below remain supported if all three are provided.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER_EMAIL=

# Tool Integrations - WhatsApp / Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Frontend Next.js Public Vars
NEXT_PUBLIC_AGENT_API_URL=http://localhost:8000
NEXT_PUBLIC_AGENT_WS_URL=ws://localhost:8000/ws/agent

# Persistent state defaults to apps/agent/data/agent.sqlite3 for native runs.
# Docker overrides this path to /app/data/agent.sqlite3 on a shared named volume.
# STATE_DB_PATH=/absolute/local/path/agent.sqlite3
API_KEY_REQUIRED=false
AGENT_API_KEY=
WEBHOOK_SECRET=
# Native runs: enable here only if not running a separate worker.
ENABLE_SCHEDULER=false

# Preferred native OAuth token location defaults to .secrets/gmail-token.json.
# GMAIL_TOKEN_PATH=C:/path/to/my_agent/.secrets/gmail-token.json
# Leave false for a pilot without AI reply-drafting costs.
# Optional local response templates during sync; always queued for human approval.
GMAIL_DRAFT_REPLIES=false
GMAIL_SYNC_MAX_PAGES=100
# Optional authenticated Pub/Sub push. Polling needs neither setting.
PUBSUB_AUDIENCE=
PUBSUB_SERVICE_ACCOUNT_EMAIL=

# Optional: Monday 07:00 SAST snapshot and email draft (requires one scheduler).
WEEKLY_REPORTS_ENABLED=false

# Free lead discovery uses public OpenStreetMap with bounded requests.
OSM_DAILY_QUERY_LIMIT=20
# Optional potentially paid search is off even if a Tavily key already exists.
TAVILY_API_KEY=
ALLOW_TAVILY_RESEARCH=false
# Processes only explicitly started jobs; Tavily opt-in and local key are also required.
RESEARCH_JOBS_ENABLED=true
# Local approval-only campaign drafting; campaigns are created paused.
CAMPAIGNS_ENABLED=true
# Processes only an explicitly enabled, mailbox-scoped follow-up draft schedule.
FOLLOWUP_SCHEDULES_ENABLED=true
# Approval-only coordinator; its mailbox configuration starts paused in Settings.
AUTOMATION_ENABLED=true
# Search + source inspection share API/worker budgets; failed attempts count.
TAVILY_DAILY_QUERY_LIMIT=5
TAVILY_MONTHLY_QUERY_LIMIT=100

# Public Overpass provider: private_coffee (default) or main. No automatic failover.
OSM_PROVIDER=private_coffee
